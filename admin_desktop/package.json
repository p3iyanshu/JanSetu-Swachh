{
  "name": "jansetu-swachh-admin",
  "productName": "JanSetu-Swachh Admin",
  "version": "1.1.0",
  "description": "Windows desktop app for the JanSetu-Swachh portal (opens on the admin login)",
  "author": "Team JanSetu",
  "private": true,
  "main": "main.js",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "start": "npm run build:web && electron .",
    "dist": "npm run build:web && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "in.jansetu.swachh.admin",
    "productName": "JanSetu-Swachh Admin",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "JanSetu-Swachh-Admin-${version}.exe"
    }
  }
}
