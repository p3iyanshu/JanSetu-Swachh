PROJECT_NAME="JanSetu Civic Resolution API"
API_V1_STR="/api/v1"
SECRET_KEY="jansetu_hackathon_secret_key_change_in_production"

# Database Configuration (PostgreSQL + PostGIS)
# Replace YOUR_POSTGRES_PASSWORD with your local postgres user password.
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/jansetu_db"

# AI / ML Service API Keys
GEMINI_API_KEY="your_gemini_api_key_here"
CLAUDE_API_KEY="your_claude_api_key_here"
ROBOFLOW_API_URL="https://serverless.roboflow.com"
ROBOFLOW_API_KEY="your_roboflow_api_key_here"
ROBOFLOW_WORKSPACE_NAME="your_roboflow_workspace_name_here"
ROBOFLOW_CONFIDENCE_THRESHOLD="0.35"
ROBOFLOW_POTHOLE_WORKFLOW_ID="your_pothole_workflow_id_here"
ROBOFLOW_ROAD_DAMAGE_WORKFLOW_ID="your_road_damage_workflow_id_here"
ROBOFLOW_SEWAGE_WORKFLOW_ID="your_sewage_workflow_id_here"
ROBOFLOW_WATER_LEAK_WORKFLOW_ID="your_water_leak_workflow_id_here"
ROBOFLOW_STREET_LIGHT_WORKFLOW_ID="your_street_light_workflow_id_here"

# Garbage detection lives on a different Roboflow account/workspace - fill
# these in only if that account differs from the one above.
ROBOFLOW_GARBAGE_WORKFLOW_ID="your_garbage_workflow_id_here"
ROBOFLOW_GARBAGE_API_KEY="your_garbage_workspace_api_key_here"
ROBOFLOW_GARBAGE_WORKSPACE_NAME="your_garbage_workspace_name_here"

# Secondary Roboflow account - direct model inference (not workflows), used
# as an extra detector alongside the existing sewage/streetlight workflows.
ROBOFLOW_SECONDARY_API_KEY="your_secondary_roboflow_api_key_here"
ROBOFLOW_SEWAGE_CLASSIFY_MODEL_ID="your_sewage_classify_model_id_here"
ROBOFLOW_STREET_LIGHT_DETECT_MODEL_ID="your_street_light_detect_model_id_here"

# Same secondary account, but these two are workflows (not direct models) on
# a third workspace - another extra detector for sewage/streetlight.
ROBOFLOW_SECONDARY_WORKSPACE_NAME="your_secondary_roboflow_workspace_name_here"
ROBOFLOW_SEWAGE_LEAK_WORKFLOW_ID="your_sewage_leak_workflow_id_here"
ROBOFLOW_STREET_LIGHT_SECONDARY_WORKFLOW_ID="your_street_light_secondary_workflow_id_here"

# Optional "Which bin?" item scan for the waste segregation guide. Any Roboflow
# classification/detection model that labels single waste items (e.g. a public
# waste-sorting model from Roboflow Universe, "<project>/<version>"). Leave blank
# and the app simply uses its searchable offline guide.
ROBOFLOW_WASTE_ITEM_MODEL_ID=
ROBOFLOW_WASTE_ITEM_API_KEY=

# Storage Configuration
STORAGE_BUCKET="jansetu-media"

# Firebase Cloud Messaging (push notifications) - optional.
# If left unset, notification_events rows are still created for audit purposes
# and the send is simply logged as "skipped" - the app stays fully usable without it.
# Set this to the absolute path of a downloaded Firebase service-account JSON file.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

# One-click demo logins on the web portal (DEMO-ADMIN / DEMO-WORKER, password
# Demo@123) are created on startup. Set to 0 for a real deployment.
JANSETU_DEMO_ACCOUNTS=1

# LAN auto-discovery: the apps find this backend on the local network via a
# UDP broadcast on this port. Set JANSETU_DISCOVERY=0 to disable.
JANSETU_DISCOVERY=1
JANSETU_DISCOVERY_PORT=45678
